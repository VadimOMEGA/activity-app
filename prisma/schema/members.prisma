// Enums
enum FullMemberKind {
    FOUNDER
    HONORARY
    REGULAR
}

enum MembershipFeeStatus {
    PAID
    UNPAID
}

// Models
model Member {
    id             String          @id @default(cuid())

    profileId      String          @unique @map("profile_id")
    profile        Profile         @relation(fields: [profileId], references: [id])

    joinedAt       DateTime        @default(now()) @map("joined_at")
    createdAt      DateTime        @default(now()) @map("created_at")
    updatedAt      DateTime        @updatedAt @map("updated_at")

    aspiringMember AspiringMember?
    fullMember     FullMember?
    membershipFee  MembershipFee[]
    generalAssemblyAttendee GeneralAssemblyAttendee?

    @@map("members")
}

model AspiringMember {
    memberId String @id @map("member_id")
    member   Member @relation(fields: [memberId], references: [id])

    @@map("aspiring_members")
}

model FullMember {
    memberId       String         @id @map("member_id")
    member         Member         @relation(fields: [memberId], references: [id])

    fullMemberKind FullMemberKind @map("full_member_kind")

    @@map("full_members")
}

model MembershipFee {
    id        String              @id @default(cuid())

    memberId  String              @map("member_id")
    member    Member              @relation(fields: [memberId], references: [id])

    year      Int
    amount    Float
    status    MembershipFeeStatus @default(UNPAID)
    
    createdAt DateTime            @default(now()) @map("created_at")
    updatedAt DateTime            @updatedAt @map("updated_at")

    @@unique([memberId, year]) // Ensure a member can only have one fee record per year
    @@map("membership_fees")
}
