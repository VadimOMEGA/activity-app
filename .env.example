# Database
DATABASE_URL="file:./database.db"

# Security
JWT_SECRET="your-super-secret-key-change-me"

# Seed Admin Account
SEED_CREATE_ADMIN=true
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin-password-here
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_NAME="Admin Name"
SEED_ADMIN_PHONE="+40700000000"
SEED_ADMIN_BIRTHDATE=1990-01-01

# S3 Storage (e.g., Filebase, AWS, MinIO)
S3_PROVIDER=filebase
S3_REGION=us-east-1
S3_BUCKET=your-bucket-name
S3_ENDPOINT=https://s3.filebase.com
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key
S3_PRESIGNED_EXPIRES_UPLOAD=300
S3_PRESIGNED_EXPIRES_DOWNLOAD=300
