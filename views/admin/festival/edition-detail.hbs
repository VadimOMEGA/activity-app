			</div>
		</div>
		<div class="modal-footer"><button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button><button class="btn btn-teal btn-sm" onclick="saveActivity()">Save</button></div>
	</div></div>
</div>

<!-- Asset Replace (hidden file input) -->
<input type="file" id="assetFileInput" style="display:none" accept="image/*,video/*">

<script>
const editionId = '{{edition.id}}'
const editionYear = {{edition.year}}

// ---- Asset Replace ----
let pendingAssetRole = null
document.getElementById('assetFileInput').addEventListener('change', async function() {
	const file = this.files[0]
	if (!file || !pendingAssetRole) return
	
	const btns = document.querySelectorAll('button[onclick^="replaceAsset"]')
	btns.forEach(b => b.disabled = true)

	try {
		showToast('Uploading...')
		const intents = await apiCall('/api/festival-editions/upload-intents', 'POST', {
			year: editionYear,
			files: [{ role: pendingAssetRole, originalFileName: file.name, contentType: file.type }]
		})
		const intent = intents[0]
		await fetch(intent.uploadUrl, { method: 'PUT', body: file, headers: { 'Content-Type': file.type } })
		const fieldMap = { logo: 'customLogoFile', hero: 'heroImageFile', secondary: 'secondaryImageFile', accent: 'accentImageFile', video: 'afterVideoFile' }
		await apiCall(`/api/festival-editions/${editionId}`, 'PUT', { [fieldMap[pendingAssetRole]]: intent.publicUrl })
		showToast('Asset replaced')
		setTimeout(() => reloadPage(), 500)
	} catch(e) { 
		showToast(e.message, 'error') 
		btns.forEach(b => b.disabled = false)
	}
	this.value = ''
	pendingAssetRole = null
})

function replaceAsset(role, label) {
	pendingAssetRole = role
	const inp = document.getElementById('assetFileInput')
	inp.accept = role === 'video' ? 'video/*' : 'image/*'
	inp.click()
}

// ---- Locations ----
function openAddLocationModal() {
	document.getElementById('locId').value = ''
	document.getElementById('locName').value = ''
	document.getElementById('locAddress').value = ''
	document.getElementById('locDesc').value = ''
	document.getElementById('locCoordinator').value = ''
	document.getElementById('locationModalTitle').textContent = 'Add Location'
	new bootstrap.Modal(document.getElementById('locationModal')).show()
}

function editLocation(loc) {
	document.getElementById('locId').value = loc.id
	document.getElementById('locName').value = loc.name
	document.getElementById('locAddress').value = loc.address || ''
	document.getElementById('locDesc').value = loc.description || ''
	document.getElementById('locCoordinator').value = loc.coordinatorId || ''
	document.getElementById('locationModalTitle').textContent = 'Edit Location'
	new bootstrap.Modal(document.getElementById('locationModal')).show()
}

async function saveLocation() {
	const id = document.getElementById('locId').value
	const name = document.getElementById('locName').value.trim()
	const address = document.getElementById('locAddress').value.trim()
	const description = document.getElementById('locDesc').value.trim()
	const coordinatorId = document.getElementById('locCoordinator').value || null
	if (!name) return showToast('Name is required', 'error')
	try {
		if (id) {
			await apiCall(`/api/festival-locations/${id}`, 'PUT', { name, address, description, coordinatorId })
		} else {
			await apiCall('/api/festival-locations', 'POST', { editionId, name, address, description, coordinatorId })
		}
		showToast(id ? 'Location updated' : 'Location added')
		bootstrap.Modal.getInstance(document.getElementById('locationModal')).hide()
		setTimeout(() => reloadPage(), 500)
	} catch(e) { showToast(e.message, 'error') }
}

function deleteLocation(id, name) {
	confirmDelete(name, async () => { await apiCall(`/api/festival-locations/${id}`, 'DELETE'); setTimeout(() => reloadPage(), 500) })
}

// ---- Sections ----
function openAddSectionModal() {
	document.getElementById('secId').value = ''
	document.getElementById('secName').value = ''
	document.getElementById('sectionModalTitle').textContent = 'Add Section'
	new bootstrap.Modal(document.getElementById('sectionModal')).show()
}

function editSection(id, name) {
	document.getElementById('secId').value = id
	document.getElementById('secName').value = name
	document.getElementById('sectionModalTitle').textContent = 'Edit Section'
	new bootstrap.Modal(document.getElementById('sectionModal')).show()
}

async function saveSection() {
	const id = document.getElementById('secId').value
	const name = document.getElementById('secName').value.trim()
	if (!name) return showToast('Name is required', 'error')
	try {
		if (id) {
			await apiCall(`/api/festival-sections/${id}`, 'PUT', { name })
		} else {
			await apiCall('/api/festival-sections', 'POST', { editionId, name })
		}
		showToast(id ? 'Section updated' : 'Section added')
		bootstrap.Modal.getInstance(document.getElementById('sectionModal')).hide()
		setTimeout(() => reloadPage(), 500)
	} catch(e) { showToast(e.message, 'error') }
}

function deleteSection(id, name) {
	confirmDelete(name, async () => { await apiCall(`/api/festival-sections/${id}`, 'DELETE'); setTimeout(() => reloadPage(), 500) })
}

// ---- Activities ----
function openAddActivityModal(sectionId) {
	document.getElementById('actId').value = ''
	document.getElementById('actSectionId').value = sectionId
	document.getElementById('actTitle').value = ''
	document.getElementById('actDesc').value = ''
	document.getElementById('actType').value = 'TALK_PANEL'
	document.getElementById('actAudience').value = 'PUBLIC'
	document.getElementById('activityModalTitle').textContent = 'Add Activity'
	new bootstrap.Modal(document.getElementById('activityModal')).show()
}

function editActivity(act) {
	document.getElementById('actId').value = act.id
	document.getElementById('actSectionId').value = act.sectionId
	document.getElementById('actTitle').value = act.title
	document.getElementById('actDesc').value = act.description
	document.getElementById('actType').value = act.activityType
	document.getElementById('actAudience').value = act.audience
	document.getElementById('activityModalTitle').textContent = 'Edit Activity'
	new bootstrap.Modal(document.getElementById('activityModal')).show()
}

async function saveActivity() {
	const id = document.getElementById('actId').value
	const sectionId = document.getElementById('actSectionId').value
	const title = document.getElementById('actTitle').value.trim()
	const description = document.getElementById('actDesc').value.trim()
	const activityType = document.getElementById('actType').value
	const audience = document.getElementById('actAudience').value
	if (!title || !description) return showToast('Title and description are required', 'error')
	try {
		if (id) {
			await apiCall(`/api/festival-activities/${id}`, 'PUT', { sectionId, title, description, activityType, audience })
		} else {
			await apiCall('/api/festival-activities', 'POST', { sectionId, title, description, activityType, audience })
		}
		showToast(id ? 'Activity updated' : 'Activity added')
		bootstrap.Modal.getInstance(document.getElementById('activityModal')).hide()
		setTimeout(() => reloadPage(), 500)
	} catch(e) { showToast(e.message, 'error') }
}

function deleteActivity(id, title) {
	confirmDelete(title, async () => { await apiCall(`/api/festival-activities/${id}`, 'DELETE'); setTimeout(() => reloadPage(), 500) })
}

// ---- Volunteers ----
const allMembers = {{{membersJson}}}

function openVolunteersModal() { new bootstrap.Modal(document.getElementById('volunteersModal')).show() }

function openAddVolunteerModal() {
	document.getElementById('volName').value = ''
	document.getElementById('volEmail').value = ''
	document.getElementById('volPhone').value = ''
	document.getElementById('volBirthDate').value = ''
	new bootstrap.Modal(document.getElementById('addVolunteerModal')).show()
}

async function addVolunteer() {
	const name = document.getElementById('volName').value.trim()
	const email = document.getElementById('volEmail').value.trim()
	const phone = document.getElementById('volPhone').value.trim()
	const birthDate = document.getElementById('volBirthDate').value
	if (!name || !email || !phone || !birthDate) return showToast('All fields required', 'error')
	try {
		await apiCall('/api/festival-volunteers', 'POST', { editionId, name, email, phone, birthDate })
		showToast('Volunteer added')
		setTimeout(() => reloadPage(), 500)
	} catch(e) { showToast(e.message, 'error') }
}

function deleteVolunteer(id, name) {
	confirmDelete(name, async () => { await apiCall(`/api/festival-volunteers/${id}`, 'DELETE'); setTimeout(() => reloadPage(), 500) })
}

// ---- Staff ----
function openStaffModal() { new bootstrap.Modal(document.getElementById('staffModal')).show() }

function openAddStaffModal() {
	const sel = document.getElementById('staffMemberId')
	sel.innerHTML = '<option value="">Select member...</option>' + allMembers.map(m =>
		`<option value="${m.id}">${escapeHtml(m.profile.name)} (${escapeHtml(m.profile.email)})</option>`
	).join('')
	new bootstrap.Modal(document.getElementById('addStaffModal')).show()
}

async function addStaff() {
	const memberId = document.getElementById('staffMemberId').value
	if (!memberId) return showToast('Select a member', 'error')
	try {
		await apiCall('/api/festival-staff-members', 'POST', { editionId, memberId })
		showToast('Staff member added')
		setTimeout(() => reloadPage(), 500)
	} catch(e) { showToast(e.message, 'error') }
}

function deleteStaff(memberId, name) {
	confirmDelete(name, async () => { await apiCall('/api/festival-staff-members', 'DELETE', { editionId, memberId }); setTimeout(() => reloadPage(), 500) })
}

// ---- Guests ----
function openGuestsModal() { new bootstrap.Modal(document.getElementById('guestsModal')).show() }

function openAddGuestModal() {
	document.getElementById('guestName').value = ''
	document.getElementById('guestEmail').value = ''
	document.getElementById('guestPhone').value = ''
	document.getElementById('guestBirthDate').value = ''
	document.querySelectorAll('.guest-role-cb').forEach(cb => cb.checked = false)
	new bootstrap.Modal(document.getElementById('addGuestModal')).show()
}

async function addGuest() {
	const name = document.getElementById('guestName').value.trim()
	const email = document.getElementById('guestEmail').value.trim()
	const phone = document.getElementById('guestPhone').value.trim()
	const birthDate = document.getElementById('guestBirthDate').value
	const roles = [...document.querySelectorAll('.guest-role-cb:checked')].map(cb => cb.value)
	if (!name || !email || !phone || !birthDate) return showToast('All fields required', 'error')
	if (roles.length === 0) return showToast('Select at least one role', 'error')
	try {
		await apiCall('/api/festival-guests', 'POST', { editionId, name, email, phone, birthDate, roles })
		showToast('Guest added')
		setTimeout(() => reloadPage(), 500)
	} catch(e) { showToast(e.message, 'error') }
}

async function updateGuestRoles(guestId) {
	const roles = [...document.querySelectorAll(`.edit-role-cb-${guestId}:checked`)].map(cb => cb.value)
	if (roles.length === 0) return showToast('Select at least one role', 'error')
	try {
		await apiCall(`/api/festival-guests/${guestId}/roles`, 'PATCH', { roles })
		showToast('Roles updated')
		setTimeout(() => reloadPage(), 500)
	} catch(e) { showToast(e.message, 'error') }
}

function deleteGuest(id, name) {
	confirmDelete(name, async () => { await apiCall(`/api/festival-guests/${id}`, 'DELETE'); setTimeout(() => reloadPage(), 500) })
}

// ---- Gallery ----
let galleryPhotos = []
let gallerySortable = null
let galleryLightbox = null
let galleryModified = false

async function openGalleryModal() {
	const modalEl = document.getElementById('galleryModal')
	const modal = new bootstrap.Modal(modalEl)

	// Attach reload-on-close listener (once)
	if (!modalEl.dataset.listenerAttached) {
		modalEl.addEventListener('hidden.bs.modal', function () {
			if (galleryModified) reloadPage()
		})
		modalEl.dataset.listenerAttached = 'true'
	}

	galleryModified = false
	modal.show()
	await loadGalleryPhotos()
}

async function loadGalleryPhotos() {
	try {
		galleryPhotos = await apiCall(`/api/festival-editions-gallery-photos/edition/${editionId}`)
		renderGalleryGrid()
	} catch(e) { showToast(e.message, 'error') }
}

function renderGalleryGrid() {
	const container = document.getElementById('galleryGrid')
	if (!galleryPhotos.length) {
		container.innerHTML = '<p class="text-secondary text-center py-4"><small>No photos yet. Upload some below.</small></p>'
		if (gallerySortable) { gallerySortable.destroy(); gallerySortable = null }
		if (galleryLightbox) { galleryLightbox.destroy(); galleryLightbox = null }
		return
	}

	container.innerHTML = galleryPhotos.map((p, i) => `
		<div class="gallery-item" data-id="${p.id}" data-index="${i}">
			<a href="${p.photoFile}" class="glightbox" data-gallery="edition-gallery" data-description="${escapeHtml(p.caption || '')}">
				<img src="${p.photoFile}" class="gallery-thumb" alt="${escapeHtml(p.caption || '')}">
			</a>
			<div class="gallery-caption-row mt-1">
				<input type="text" class="form-control form-control-md gallery-caption-input" value="${escapeHtml(p.caption || '')}" placeholder="Caption..." data-id="${p.id}">
				<button class="btn btn-outline-danger btn-sm ms-1" onclick="deleteGalleryPhoto('${p.id}')" title="Delete"><i class="bi bi-trash"></i></button>
			</div>
		</div>
	`).join('')

	// Init SortableJS
	if (gallerySortable) gallerySortable.destroy()
	gallerySortable = Sortable.create(container, {
		animation: 150,
		ghostClass: 'gallery-drag-ghost',
		handle: '.gallery-thumb',
		onEnd: async function() {
			const items = [...container.children].map((el, i) => ({ id: el.dataset.id, sortOrder: i }))
			try {
				await apiCall('/api/festival-editions-gallery-photos/reorder', 'PATCH', { items })
				galleryPhotos = items.map(item => {
					const photo = galleryPhotos.find(p => p.id === item.id)
					return { ...photo, sortOrder: item.sortOrder }
				})
				galleryModified = true
				showToast('Gallery reordered')
			} catch(e) { showToast(e.message, 'error') }
		}
	})

	// Init GLightbox
	if (galleryLightbox) galleryLightbox.destroy()
	galleryLightbox = GLightbox({
		selector: '.glightbox',
		touchNavigation: true,
		loop: true,
		closeOnOutsideClick: true
	})

	// Caption blur handlers
	container.querySelectorAll('.gallery-caption-input').forEach(input => {
		const originalVal = input.value
		input.addEventListener('blur', async function() {
			const newCaption = this.value.trim()
			if (newCaption === originalVal) return
			try {
				await apiCall(`/api/festival-editions-gallery-photos/${this.dataset.id}/caption`, 'PUT', { caption: newCaption })
				galleryModified = true
				showToast('Caption updated')
			} catch(e) { 
				showToast(e.message, 'error')
				this.value = originalVal
			}
		})
	})
}

async function deleteGalleryPhoto(id) {
	confirmDelete('this photo', async () => {
		try {
			await apiCall(`/api/festival-editions-gallery-photos/${id}`, 'DELETE')
			galleryPhotos = galleryPhotos.filter(p => p.id !== id)
			galleryModified = true
			renderGalleryGrid()
			showToast('Photo deleted')
		} catch(e) { showToast(e.message, 'error') }
	})
}

async function uploadGalleryPhotos() {
	const fileInput = document.getElementById('galleryFileInput')
	const files = [...fileInput.files]
	if (!files.length) return

	const uploadBtn = document.getElementById('btnUploadGallery')
	uploadBtn.disabled = true
	fileInput.disabled = true
	showToast(`Uploading ${files.length} photo(s)...`)

	let successCount = 0
	const startOrder = galleryPhotos.length

	for (let i = 0; i < files.length; i++) {
		const file = files[i]
		try {
			const result = await apiCall(`/api/festival-editions-gallery-photos/edition/${editionId}/upload-intent`, 'POST', {
				originalFileName: file.name,
				contentType: file.type,
				caption: '',
				sortOrder: startOrder + i
			})
			await fetch(result.upload.uploadUrl, { method: 'PUT', body: file, headers: { 'Content-Type': file.type } })
			await apiCall(`/api/festival-editions-gallery-photos/${result.photo.id}/confirm-upload`, 'POST')
			successCount++
		} catch(e) {
			showToast(`Failed to upload ${file.name}: ${e.message}`, 'error')
		}
	}

	fileInput.value = ''
	fileInput.disabled = false
	uploadBtn.disabled = false

	if (successCount > 0) {
		galleryModified = true
		showToast(`${successCount} photo(s) uploaded`)
		await loadGalleryPhotos()
	}
}
</script>

