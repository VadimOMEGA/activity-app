{{> head}}
{{> edition_tabs}}

{{#unless edition}}
<div class="text-center text-secondary py-5"><i class="bi bi-exclamation-triangle display-4"></i><p class="mt-2">Edition not found</p></div>
{{else}}

<div class="row g-3">
	<!-- Assets Card -->
	<div class="col-md-7">
		<div class="card bg-dark border-secondary h-100">
			<div class="card-header d-flex justify-content-between align-items-center">
				<span><i class="bi bi-image me-2 text-teal"></i>Edition Assets</span>
			</div>
			<div class="card-body">
				<div class="row g-2">
					{{#each (assetList edition)}}
					<div class="col-12 d-flex align-items-center gap-2 py-1">
						<span class="text-secondary" style="min-width:90px;font-size:0.8rem;">{{this.label}}:</span>
						{{#if this.isImage}}
							{{#if this.url}}
							<img src="{{this.url}}" class="rounded" style="width:40px;height:40px;object-fit:cover;">
							{{else}}
							<span class="badge bg-secondary">None</span>
							{{/if}}
						{{else}}
							{{#if this.url}}
							<span class="badge bg-info">Uploaded</span>
							{{else}}
							<span class="badge bg-secondary">None</span>
							{{/if}}
						{{/if}}
						{{#if ../canEdit}}
						<button class="btn btn-outline-light btn-sm ms-auto" style="font-size:0.7rem;" onclick='replaceAsset("{{this.role}}", "{{this.label}}")'>
							<i class="bi bi-arrow-repeat"></i> Replace
						</button>
						{{/if}}
					</div>
					{{/each}}
				</div>
			</div>
		</div>
	</div>

	<!-- Stats Card -->
	<div class="col-md-5">
		<div class="card bg-dark border-secondary h-100">
			<div class="card-header"><i class="bi bi-bar-chart me-2 text-teal"></i>Quick Stats</div>
			<div class="card-body p-0">
				<table class="table table-dark table-sm mb-0" style="font-size:0.85rem;">
					<tbody>
						<tr><td class="ps-3 py-2">Sections</td><td class="text-end pe-3"><span class="badge bg-info">{{counts.sections}}</span></td></tr>
						<tr><td class="ps-3 py-2">Activities</td><td class="text-end pe-3"><span class="badge bg-info">{{counts.activities}}</span></td></tr>
						<tr><td class="ps-3 py-2">Locations</td><td class="text-end pe-3"><span class="badge bg-info">{{counts.locations}}</span></td></tr>
						<tr><td class="ps-3 py-2">Volunteers</td><td class="text-end pe-3"><span class="badge bg-info">{{counts.volunteers}}</span></td></tr>
						<tr><td class="ps-3 py-2">Staff</td><td class="text-end pe-3"><span class="badge bg-info">{{counts.staff}}</span></td></tr>
						<tr><td class="ps-3 py-2">Guests</td><td class="text-end pe-3"><span class="badge bg-info">{{counts.guests}}</span></td></tr>
						<tr><td class="ps-3 py-2">Sponsors</td><td class="text-end pe-3"><span class="badge bg-warning text-dark">{{counts.sponsors}}</span></td></tr>
						<tr><td class="ps-3 py-2">Tickets</td><td class="text-end pe-3"><span class="badge bg-warning text-dark">{{counts.tickets}}</span></td></tr>
						<tr><td class="ps-3 py-2">Gallery</td><td class="text-end pe-3"><span class="badge bg-success">{{counts.gallery}}</span></td></tr>
					</tbody>
				</table>
			</div>
		</div>
	</div>

	<!-- Gallery Card -->
	<div class="col-12">
		<div class="card bg-dark border-secondary">
			<div class="card-header d-flex justify-content-between align-items-center">
				<span><i class="bi bi-images me-2 text-teal"></i>Gallery ({{counts.gallery}})</span>
				{{#if canEdit}}
				<button class="btn btn-teal btn-sm" onclick="openGalleryModal()">Manage <i class="bi bi-arrow-right ms-1"></i></button>
				{{/if}}
			</div>
			<div class="card-body">
				{{#if edition.festivalEditionGalleryPhotos.length}}
				<div class="d-flex gap-2 flex-wrap">
					{{#each edition.festivalEditionGalleryPhotos}}
					{{#if (lt @index 8)}}
					<img src="{{this.photoFile}}" class="rounded gallery-thumb-sm" style="width:80px;height:80px;object-fit:cover;cursor:pointer;" title="{{this.caption}}">
					{{/if}}
					{{/each}}
					{{#if (gt counts.gallery 8)}}
					<div class="d-flex align-items-center justify-content-center rounded" style="width:80px;height:80px;background:var(--ai3-dark-surface);color:var(--ai3-teal-light);font-size:0.85rem;">
						+{{subtract counts.gallery 8}} more
					</div>
					{{/if}}
				</div>
				{{else}}
				<p class="text-secondary mb-0"><small>No photos yet</small></p>
				{{/if}}
			</div>
		</div>
	</div>

	<!-- Locations Card -->
	<div class="col-md-6">
		<div class="card bg-dark border-secondary h-100">
			<div class="card-header d-flex justify-content-between align-items-center">
				<span><i class="bi bi-geo-alt me-2 text-teal"></i>Locations ({{counts.locations}})</span>
				{{#if canEdit}}
				<button class="btn btn-teal btn-sm" onclick="openAddLocationModal()"><i class="bi bi-plus-lg"></i></button>
				{{/if}}
			</div>
			<div class="card-body p-0">
				{{#if edition.festivalLocations.length}}
				<table class="table table-dark table-sm mb-0" style="font-size:0.85rem;">
					<thead><tr><th class="ps-3">Name</th><th>Coordinator</th>{{#if canEdit}}<th class="text-end pe-3">Actions</th>{{/if}}</tr></thead>
					<tbody>
						{{#each edition.festivalLocations}}
						<tr>
							<td class="ps-3">{{this.name}}</td>
							<td>{{#if this.coordinator}}{{this.coordinator.profile.name}}{{else}}—{{/if}}</td>
							{{#if ../canEdit}}
							<td class="text-end pe-3">
								<button class="btn btn-outline-light btn-sm me-1" onclick='editLocation({{{json this}}})' title="Edit"><i class="bi bi-pencil"></i></button>
								<button class="btn btn-outline-danger btn-sm" onclick='deleteLocation("{{this.id}}", "{{this.name}}")' title="Delete"><i class="bi bi-trash"></i></button>
							</td>
							{{/if}}
						</tr>
						{{/each}}
					</tbody>
				</table>
				{{else}}
				<p class="text-secondary mb-0 p-3"><small>No locations yet</small></p>
				{{/if}}
			</div>
		</div>
	</div>

	<!-- People Card -->
	<div class="col-md-6">
		<div class="card bg-dark border-secondary h-100">
			<div class="card-header"><i class="bi bi-people me-2 text-teal"></i>People</div>
			<div class="card-body">
				<div class="d-flex flex-column gap-2">
					<div class="d-flex justify-content-between align-items-center">
						<span>Volunteers</span>
						<div>
							<span class="badge bg-info me-2">{{counts.volunteers}}</span>
							{{#if canEdit}}<button class="btn btn-outline-light btn-sm" onclick="openVolunteersModal()">Manage</button>{{/if}}
						</div>
					</div>
					<div class="d-flex justify-content-between align-items-center">
						<span>Staff</span>
						<div>
							<span class="badge bg-info me-2">{{counts.staff}}</span>
							{{#if canEdit}}<button class="btn btn-outline-light btn-sm" onclick="openStaffModal()">Manage</button>{{/if}}
						</div>
					</div>
					<div class="d-flex justify-content-between align-items-center">
						<span>Guests</span>
						<div>
							<span class="badge bg-info me-2">{{counts.guests}}</span>
							{{#if canEdit}}<button class="btn btn-outline-light btn-sm" onclick="openGuestsModal()">Manage</button>{{/if}}
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Sections & Activities Card -->
	<div class="col-12">
		<div class="card bg-dark border-secondary">
			<div class="card-header d-flex justify-content-between align-items-center">
				<span><i class="bi bi-collection me-2 text-teal"></i>Sections & Activities ({{counts.sections}} sections, {{counts.activities}} activities)</span>
				{{#if canEdit}}
				<button class="btn btn-teal btn-sm" onclick="openAddSectionModal()"><i class="bi bi-plus-lg me-1"></i>Add Section</button>
				{{/if}}
			</div>
			<div class="card-body p-0">
				{{#if edition.festivalSections.length}}
				<div class="accordion accordion-flush" id="sectionsAccordion">
					{{#each edition.festivalSections}}
					<div class="accordion-item bg-transparent">
						<h2 class="accordion-header">
							<button class="accordion-button collapsed bg-transparent text-light py-2 px-3" type="button"
								data-bs-toggle="collapse" data-bs-target="#section-{{this.id}}">
								<strong>{{this.name}}</strong>
								<span class="badge bg-secondary ms-2">{{this.festivalActivities.length}} activities</span>
							</button>
						</h2>
						<div id="section-{{this.id}}" class="accordion-collapse collapse" data-bs-parent="#sectionsAccordion">
							<div class="accordion-body py-2 px-3">
								<div class="d-flex justify-content-between mb-2">
									{{#if ../canEdit}}
									<div>
										<button class="btn btn-outline-light btn-sm me-1" onclick='editSection("{{this.id}}", "{{this.name}}")' title="Edit Section"><i class="bi bi-pencil me-1"></i>Edit</button>
										<button class="btn btn-outline-danger btn-sm" onclick='deleteSection("{{this.id}}", "{{this.name}}")' title="Delete Section"><i class="bi bi-trash me-1"></i>Delete</button>
									</div>
									<button class="btn btn-teal btn-sm" onclick='openAddActivityModal("{{this.id}}")'><i class="bi bi-plus-lg me-1"></i>Add Activity</button>
									{{/if}}
								</div>
								{{#if this.festivalActivities.length}}
								<table class="table table-dark table-sm mb-0" style="font-size:0.8rem;">
									<thead><tr><th>Title</th><th>Type</th><th>Audience</th>{{#if ../canEdit}}<th class="text-end">Actions</th>{{/if}}</tr></thead>
									<tbody>
										{{#each this.festivalActivities}}
										<tr>
											<td>{{this.title}}</td>
											<td><span class="badge bg-secondary">{{this.activityType}}</span></td>
											<td><span class="badge bg-info">{{this.audience}}</span></td>
											{{#if ../../canEdit}}
											<td class="text-end">
												<button class="btn btn-outline-light btn-sm me-1" onclick='editActivity({{{json this}}})' title="Edit"><i class="bi bi-pencil"></i></button>
												<button class="btn btn-outline-danger btn-sm" onclick='deleteActivity("{{this.id}}", "{{this.title}}")' title="Delete"><i class="bi bi-trash"></i></button>
											</td>
											{{/if}}
										</tr>
										{{/each}}
									</tbody>
								</table>
								{{else}}
								<p class="text-secondary mb-0"><small>No activities in this section</small></p>
								{{/if}}
							</div>
						</div>
					</div>
					{{/each}}
				</div>
				{{else}}
				<p class="text-secondary mb-0 p-3"><small>No sections yet</small></p>
				{{/if}}
			</div>
		</div>
	</div>
</div>

<!-- Location Modal -->
<div class="modal fade" id="locationModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog"><div class="modal-content">
		<div class="modal-header"><h5 class="modal-title" id="locationModalTitle">Add Location</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
		<div class="modal-body">
			<input type="hidden" id="locId">
			<div class="mb-3"><label class="form-label">Name</label><input type="text" class="form-control" id="locName"></div>
			<div class="mb-3"><label class="form-label">Address</label><input type="text" class="form-control" id="locAddress"></div>
			<div class="mb-3"><label class="form-label">Description</label><textarea class="form-control" id="locDesc" rows="3"></textarea></div>
			<div class="mb-3">
				<label class="form-label">Coordinator (Volunteer)</label>
				<select class="form-select" id="locCoordinator">
					<option value="">None</option>
					{{#each edition.festivalVolunteers}}
					<option value="{{this.id}}">{{this.profile.name}}</option>
					{{/each}}
				</select>
			</div>
		</div>
		<div class="modal-footer"><button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button><button class="btn btn-teal btn-sm" onclick="saveLocation()">Save</button></div>
	</div></div>
</div>

<!-- Section Modal -->
<div class="modal fade" id="sectionModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog"><div class="modal-content">
		<div class="modal-header"><h5 class="modal-title" id="sectionModalTitle">Add Section</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
		<div class="modal-body">
			<input type="hidden" id="secId">
			<div class="mb-3"><label class="form-label">Name</label><input type="text" class="form-control" id="secName"></div>
		</div>
		<div class="modal-footer"><button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button><button class="btn btn-teal btn-sm" onclick="saveSection()">Save</button></div>
	</div></div>
</div>

<!-- Activity Modal -->
<div class="modal fade" id="activityModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog"><div class="modal-content">
		<div class="modal-header"><h5 class="modal-title" id="activityModalTitle">Add Activity</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
		<div class="modal-body">
			<input type="hidden" id="actId">
			<input type="hidden" id="actSectionId">
			<div class="mb-3"><label class="form-label">Title</label><input type="text" class="form-control" id="actTitle"></div>
			<div class="mb-3"><label class="form-label">Description</label><textarea class="form-control" id="actDesc" rows="2"></textarea></div>
			<div class="row g-3">
				<div class="col-md-6">
					<label class="form-label">Type</label>
					<select class="form-select" id="actType">
						<option value="TALK_PANEL">Talk / Panel</option>
						<option value="TALK_KEYNOTE">Keynote</option>
