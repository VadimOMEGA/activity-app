<!-- Guests Modal -->
<div class="modal fade" id="guestsModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-lg"><div class="modal-content">
		<div class="modal-header"><h5 class="modal-title">Guests</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
		<div class="modal-body">
			<button class="btn btn-teal btn-sm mb-3" onclick="openAddGuestModal()"><i class="bi bi-plus-lg me-1"></i>Add Guest</button>
			{{#if edition.festivalGuests.length}}
			<table class="table table-dark table-sm" style="font-size:0.85rem;">
				<thead><tr><th>Name</th><th>Email</th><th>Roles</th><th class="text-end">Actions</th></tr></thead>
				<tbody>
					{{#each edition.festivalGuests}}
					<tr>
						<td>{{this.profile.name}}</td><td>{{this.profile.email}}</td>
						<td>
							{{#each this.festivalGuestRoles}}
							<span class="badge {{guestRoleBadge this.role}} me-1">{{this.role}}</span>
							{{/each}}
						</td>
						<td class="text-end text-nowrap">
							<button class="btn btn-outline-light btn-sm me-1" title="Edit Profile" onclick='openProfileModal("{{this.profile.id}}", "{{this.profile.name}}", "{{this.profile.email}}", "{{this.profile.phone}}", "{{this.profile.birthDate}}")'><i class="bi bi-person"></i></button>
							<button class="btn btn-outline-light btn-sm me-1" data-bs-toggle="collapse" data-bs-target="#editRoles-{{this.id}}" title="Edit Roles"><i class="bi bi-shield"></i></button>
							<button class="btn btn-outline-danger btn-sm" onclick='deleteGuest("{{this.id}}", "{{this.profile.name}}")'><i class="bi bi-trash"></i></button>
						</td>
					</tr>
					<tr>
						<td colspan="4" class="p-0 border-0">
							<div class="collapse" id="editRoles-{{this.id}}">
								<div class="py-2 px-0 d-flex gap-2 flex-wrap align-items-center">
									{{#each ../guestRoles}}
									<div class="form-check form-check-inline">
										<input class="form-check-input edit-role-cb-{{../this.id}}" type="checkbox" value="{{this}}" id="er-{{../this.id}}-{{this}}">
										<label class="form-check-label" for="er-{{../this.id}}-{{this}}" style="font-size:0.8rem;">{{this}}</label>
									</div>
									{{/each}}
									<button class="btn btn-teal btn-sm ms-auto" onclick='updateGuestRoles("{{this.id}}")'>Update</button>
								</div>
							</div>
						</td>
					</tr>
					{{/each}}
				</tbody>
			</table>
			<script>
			// Pre-check existing roles
			{{#each edition.festivalGuests}}
			{{#each this.festivalGuestRoles}}
			document.querySelector('.edit-role-cb-{{../this.id}}[value="{{this.role}}"]')?.setAttribute('checked','')
			{{/each}}
			{{/each}}
			</script>
			{{else}}<p class="text-secondary">No guests yet</p>{{/if}}
		</div>
	</div></div>
</div>

