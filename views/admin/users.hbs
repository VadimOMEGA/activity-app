{{> head}}
<div class="page-header">
	<h1>Users</h1>
</div>

<div class="table-responsive">
	<table class="table table-dark table-striped table-hover">
		<thead>
			<tr>
				<th>Username</th>
				<th>Name</th>
				<th>Email</th>
				<th>Roles</th>
				<th>Created</th>
				{{#if canEdit}}<th class="text-end">Actions</th>{{/if}}
			</tr>
		</thead>
		<tbody>
			{{#each users}}
			<tr>
				<td>{{this.username}}</td>
				<td>{{this.profile.name}}</td>
				<td>{{this.profile.email}}</td>
				<td>
					{{#each this.roles}}
					<span class="badge badge-role-{{toLowerCase this.role.name}} me-1">{{this.role.name}}</span>
					{{/each}}
				</td>
				<td>{{formatDate this.createdAt}}</td>
				{{#if ../canEdit}}
				<td class="text-end">
					<button class="btn btn-outline-teal btn-sm me-1" title="Assign Roles"
						onclick='openRolesModal("{{this.id}}", "{{this.username}}", {{{json this.roles}}})'>
						<i class="bi bi-shield-lock"></i>
					</button>
					<button class="btn btn-outline-light btn-sm me-1" title="Edit Profile"
						onclick='openProfileModal("{{this.profile.id}}", "{{this.profile.name}}", "{{this.profile.email}}", "{{this.profile.phone}}", "{{this.profile.birthDate}}")'>
						<i class="bi bi-pencil"></i>
					</button>
					<button class="btn btn-outline-danger btn-sm" title="Delete"
						onclick='deleteUser("{{this.id}}", "{{this.username}}")'>
						<i class="bi bi-trash"></i>
					</button>
				</td>
				{{/if}}
			</tr>
			{{/each}}
		</tbody>
	</table>
</div>

{{#unless users.length}}
<div class="text-center text-secondary py-5">
	<i class="bi bi-people display-4"></i>
	<p class="mt-2">No users found</p>
</div>
{{/unless}}

<!-- Roles Assignment Modal -->
<div class="modal fade" id="rolesModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title">Assign Roles — <span id="rolesUsername" class="text-teal"></span></h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal"></button>
			</div>
			<div class="modal-body">
				<input type="hidden" id="rolesUserId">
				<div id="rolesCheckboxes">
					{{#each roles}}
					<div class="form-check mb-2">
						<input class="form-check-input" type="checkbox" value="{{this.name}}" id="role-{{this.name}}">
						<label class="form-check-label" for="role-{{this.name}}">
							<span class="badge badge-role-{{toLowerCase this.name}}">{{this.name}}</span>
						</label>
					</div>
					{{/each}}
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
				<button type="button" class="btn btn-teal btn-sm" onclick="saveRoles()">Save Roles</button>
			</div>
		</div>
	</div>
</div>

<script>
	// Format dates on load
	document.querySelectorAll('td').forEach(td => {
		if (td.textContent && td.textContent.match(/^\d{4}-\d{2}-\d{2}T/)) {
			td.textContent = formatDate(td.textContent)
		}
	})

	function openRolesModal(userId, username, currentRoles) {
		document.getElementById('rolesUserId').value = userId
		document.getElementById('rolesUsername').textContent = username

		// Uncheck all first
		document.querySelectorAll('#rolesCheckboxes input[type="checkbox"]').forEach(cb => {
			cb.checked = false
		})

		// Check current roles
		if (Array.isArray(currentRoles)) {
			currentRoles.forEach(ur => {
				const cb = document.getElementById('role-' + ur.role.name)
				if (cb) cb.checked = true
			})
		}

		new bootstrap.Modal(document.getElementById('rolesModal')).show()
	}

	async function saveRoles() {
		const userId = document.getElementById('rolesUserId').value
		const checkboxes = document.querySelectorAll('#rolesCheckboxes input[type="checkbox"]:checked')
		const roleNames = Array.from(checkboxes).map(cb => cb.value)

		try {
			await apiCall(`/api/users/roles/${userId}`, 'PUT', { roleNames })
			showToast('Roles updated successfully')
			bootstrap.Modal.getInstance(document.getElementById('rolesModal')).hide()
			setTimeout(() => reloadPage(), 500)
		} catch (err) {
			showToast(err.message || 'Failed to assign roles', 'error')
		}
	}

	function deleteUser(userId, username) {
		confirmDelete(username, async () => {
			await apiCall(`/api/users/${userId}`, 'DELETE')
			setTimeout(() => reloadPage(), 500)
		})
	}
</script>

{{> foot}}