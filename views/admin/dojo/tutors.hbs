{{> head}}
<div class="page-header">
	<h1>CoderDojo — Tutors</h1>
	{{#if canEdit}}
	<button class="btn btn-teal btn-sm" onclick="openCreateTutorModal()">
		<i class="bi bi-plus-lg me-1"></i>New Tutor
	</button>
	{{/if}}
</div>

<div class="table-responsive">
	<table class="table table-dark table-striped table-hover">
		<thead>
			<tr>
				<th>Name</th>
				<th>Email</th>
				<th>Ninjas</th>
				<th>Signatures</th>
				{{#if canEdit}}<th class="text-end">Actions</th>{{/if}}
			</tr>
		</thead>
		<tbody>
			{{#each tutors}}
			<tr>
				<td>{{this.profile.name}}</td>
				<td>{{this.profile.email}}</td>
				<td><span class="badge bg-secondary">{{this.dojoNinjas.length}}</span></td>
				<td><span class="badge bg-secondary">{{this.tutorAgreementSignatures.length}}</span></td>
				{{#if ../canEdit}}
				<td class="text-end">
					<button class="btn btn-outline-light btn-sm me-1" title="Edit Profile"
						onclick='openProfileModal("{{this.profile.id}}", "{{this.profile.name}}", "{{this.profile.email}}", "{{this.profile.phone}}", "{{this.profile.birthDate}}")'>
						<i class="bi bi-person"></i>
					</button>
					<button class="btn btn-outline-teal btn-sm me-1" title="Signatures"
						onclick='openTutorSigModal("{{this.id}}", {{{json this.tutorAgreementSignatures}}})'>
						<i class="bi bi-pen"></i>
					</button>
					<button class="btn btn-outline-danger btn-sm" title="Delete"
						onclick='deleteTutor("{{this.id}}", "{{this.profile.name}}")'>
						<i class="bi bi-trash"></i>
					</button>
				</td>
				{{/if}}
			</tr>
			<!-- Ninjas accordion -->
			<tr>
				<td colspan="{{#if ../canEdit}}5{{else}}4{{/if}}" class="p-0">
					<div class="accordion accordion-flush">
						<div class="accordion-item">
							<h2 class="accordion-header">
								<button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#ninjas-{{this.id}}">
									<i class="bi bi-people me-2"></i> Ninjas ({{this.dojoNinjas.length}})
								</button>
							</h2>
							<div id="ninjas-{{this.id}}" class="accordion-collapse collapse">
								<div class="accordion-body">
									{{#if ../canEdit}}
									<div class="mb-2 text-end">
										<button class="btn btn-teal btn-sm" onclick='openNinjaModal("{{this.id}}")'>
											<i class="bi bi-plus-lg me-1"></i>Add Ninja
										</button>
									</div>
									{{/if}}
									{{#if this.dojoNinjas.length}}
									<table class="table table-dark table-sm table-hover mb-0">
										<thead><tr><th>Name</th><th>Info</th>{{#if ../canEdit}}<th class="text-end">Actions</th>{{/if}}</tr></thead>
										<tbody>
											{{#each this.dojoNinjas}}
											<tr>
												<td>{{this.profile.name}}</td>
												<td class="truncate">{{this.usefulInfo}}</td>
												{{#if ../../canEdit}}
												<td class="text-end">
													<button class="btn btn-outline-light btn-sm me-1" onclick='editNinja("{{this.id}}", "{{this.tutorId}}", `{{this.usefulInfo}}`)'><i class="bi bi-pencil"></i></button>
													<button class="btn btn-outline-light btn-sm me-1" onclick='openProfileModal("{{this.profile.id}}", "{{this.profile.name}}", "{{this.profile.email}}", "{{this.profile.phone}}", "{{this.profile.birthDate}}")'><i class="bi bi-person"></i></button>
													<button class="btn btn-outline-danger btn-sm" onclick='delNinja("{{this.id}}", "{{this.profile.name}}")'><i class="bi bi-trash"></i></button>
												</td>
												{{/if}}
											</tr>
											{{/each}}
										</tbody>
									</table>
									{{else}}<p class="text-secondary mb-0 small">No ninjas</p>{{/if}}
								</div>
							</div>
						</div>
					</div>
				</td>
			</tr>
			{{/each}}
		</tbody>
	</table>
</div>

{{#unless tutors.length}}
<div class="text-center text-secondary py-5"><i class="bi bi-person-workspace display-4"></i><p class="mt-2">No tutors</p></div>
{{/unless}}

<!-- Create Tutor Modal -->
<div class="modal fade" id="createTutorModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog"><div class="modal-content">
		<div class="modal-header"><h5 class="modal-title">New Tutor</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
		<div class="modal-body">
			<div class="mb-3">
				<label class="form-label">Full Name</label>
				<input type="text" class="form-control" id="tutorName" required>
			</div>
			<div class="mb-3">
				<label class="form-label">Email</label>
				<input type="email" class="form-control" id="tutorEmail" required>
			</div>
			<div class="row">
				<div class="col-md-6 mb-3">
					<label class="form-label">Phone</label>
					<input type="text" class="form-control" id="tutorPhone" required>
				</div>
				<div class="col-md-6 mb-3">
					<label class="form-label">Birth Date</label>
					<input type="date" class="form-control" id="tutorBirthDate" required>
				</div>
			</div>
		</div>
		<div class="modal-footer"><button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button><button class="btn btn-teal btn-sm" onclick="createTutor()">Create</button></div>
	</div></div>
</div>

<!-- Ninja Modal -->
<div class="modal fade" id="ninjaModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog"><div class="modal-content">
		<div class="modal-header"><h5 class="modal-title" id="ninjaTitle">Add Ninja</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
		<div class="modal-body">
			<input type="hidden" id="ninjaId"><input type="hidden" id="ninjaTutorId">
			<div id="ninjaProfileFields">
				<div class="mb-3">
					<label class="form-label">Ninja Name</label>
					<input type="text" class="form-control" id="ninjaName">
				</div>
				<div class="mb-3">
					<label class="form-label">Email</label>
					<input type="email" class="form-control" id="ninjaEmail">
				</div>
				<div class="row">
					<div class="col-md-6 mb-3">
						<label class="form-label">Phone</label>
						<input type="text" class="form-control" id="ninjaPhone">
					</div>
					<div class="col-md-6 mb-3">
						<label class="form-label">Birth Date</label>
						<input type="date" class="form-control" id="ninjaBirthDate">
					</div>
				</div>
			</div>
			<div class="mb-3"><label class="form-label">Useful Info</label><textarea class="form-control" id="ninjaInfo" rows="3"></textarea></div>
		</div>
		<div class="modal-footer"><button class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button><button class="btn btn-teal btn-sm" onclick="saveNinja()">Save</button></div>
	</div></div>
</div>

<!-- Tutor Signatures Modal -->
<div class="modal fade" id="tutorSigModal" tabindex="-1" aria-hidden="true">
	<div class="modal-dialog modal-lg"><div class="modal-content">
		<div class="modal-header"><h5 class="modal-title">Manage Signatures</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
		<div class="modal-body" id="tutorSigBody"></div>
	</div></div>
</div>

<script>
const docs = {{{json documents}}}
let sigTutorId = null, sigList = []

function openCreateTutorModal(){
	document.getElementById('tutorName').value = '';
	document.getElementById('tutorEmail').value = '';
	document.getElementById('tutorPhone').value = '';
	document.getElementById('tutorBirthDate').value = '';
	new bootstrap.Modal(document.getElementById('createTutorModal')).show()
}
async function createTutor(){
	const name = document.getElementById('tutorName').value;
	const email = document.getElementById('tutorEmail').value;
	const phone = document.getElementById('tutorPhone').value;
	const birthDate = document.getElementById('tutorBirthDate').value;
	
	if(!name || !email || !phone || !birthDate) return showToast('Fill all fields','error');
	
	try{
		await apiCall('/api/dojo-tutors','POST',{ name, email, phone, birthDate: new Date(birthDate).toISOString() });
		showToast('Created');
		setTimeout(()=>reloadPage(),500)
	}catch(e){
		showToast(e.message,'error')
	}
}
function deleteTutor(id,n){confirmDelete(n,async()=>{await apiCall(`/api/dojo-tutors/${id}`,'DELETE');setTimeout(()=>reloadPage(),500)})}

function openNinjaModal(tid){
	document.getElementById('ninjaId').value='';
	document.getElementById('ninjaTutorId').value=tid;
	document.getElementById('ninjaName').value='';
	document.getElementById('ninjaEmail').value='';
	document.getElementById('ninjaPhone').value='';
	document.getElementById('ninjaBirthDate').value='';
	document.getElementById('ninjaInfo').value='';
	document.getElementById('ninjaProfileFields').style.display='block';
	document.getElementById('ninjaTitle').textContent='Add Ninja';
	new bootstrap.Modal(document.getElementById('ninjaModal')).show()
}
function editNinja(id,tid,info){
	document.getElementById('ninjaId').value=id;
	document.getElementById('ninjaTutorId').value=tid;
	document.getElementById('ninjaInfo').value=info||'';
	document.getElementById('ninjaProfileFields').style.display='none';
	document.getElementById('ninjaTitle').textContent='Edit Ninja';
	new bootstrap.Modal(document.getElementById('ninjaModal')).show()
}
async function saveNinja(){
	const id=document.getElementById('ninjaId').value,
		  tid=document.getElementById('ninjaTutorId').value,
		  info=document.getElementById('ninjaInfo').value;
	try{
		if(id){
			await apiCall(`/api/dojo-ninjas/${id}`,'PUT',{tutorId:tid,usefulInfo:info});
			showToast('Updated')
		}else{
			const name = document.getElementById('ninjaName').value;
			const email = document.getElementById('ninjaEmail').value;
			const phone = document.getElementById('ninjaPhone').value;
			const birthDate = document.getElementById('ninjaBirthDate').value;
			
			if(!name || !email || !phone || !birthDate) return showToast('Fill all fields','error');
			
			await apiCall('/api/dojo-ninjas','POST',{
				tutorId: tid,
				usefulInfo: info,
				name,
				email,
				phone,
				birthDate: new Date(birthDate).toISOString()
			});
			showToast('Created')
		}
		bootstrap.Modal.getInstance(document.getElementById('ninjaModal')).hide();
		setTimeout(()=>reloadPage(),500)
	}catch(e){
		showToast(e.message,'error')
	}
}
function delNinja(id,n){confirmDelete(n,async()=>{await apiCall(`/api/dojo-ninjas/${id}`,'DELETE');setTimeout(()=>reloadPage(),500)})}

function openTutorSigModal(tid,sigs){sigTutorId=tid;sigList=sigs||[];renderSigs();new bootstrap.Modal(document.getElementById('tutorSigModal')).show()}
function renderSigs(){const b=document.getElementById('tutorSigBody');let h='<table class="table table-dark table-sm mb-0"><thead><tr><th>Document</th><th class="text-end">Status</th></tr></thead><tbody>';docs.forEach(d=>{const s=sigList.find(x=>x.documentId===d.id);h+=`<tr id="ts-${d.id}"><td>${escapeHtml(d.name)}</td><td class="text-end">`;if(s){h+=`<span class="text-success me-2"><i class="bi bi-check-circle-fill"></i> Signed ${formatDate(s.signedAt)}</span><button class="btn btn-outline-danger btn-sm" onclick="rmSig('${s.id}','${d.id}')"><i class="bi bi-x-lg"></i></button>`}else{h+=`<button class="btn btn-teal btn-sm" onclick="addSig('${d.id}')"><i class="bi bi-pen me-1"></i>Sign</button>`}h+='</td></tr>'});h+='</tbody></table>';b.innerHTML=h}
async function addSig(did){document.getElementById('ts-'+did).classList.add('row-loader');try{const r=await apiCall('/api/tutor-agreement-signatures','POST',{tutorId:sigTutorId,documentId:did});sigList.push(r);renderSigs();showToast('Signed');setTimeout(() => reloadPage(), 500)}catch(e){showToast(e.message,'error');document.getElementById('ts-'+did).classList.remove('row-loader');}}
async function rmSig(sid,did){document.getElementById('ts-'+did).classList.add('row-loader');try{await apiCall(`/api/tutor-agreement-signatures/${sid}`,'DELETE');sigList=sigList.filter(s=>s.id!==sid);renderSigs();showToast('Removed');setTimeout(() => reloadPage(), 500)}catch(e){showToast(e.message,'error');document.getElementById('ts-'+did).classList.remove('row-loader');}}
</script>

{{> foot}}