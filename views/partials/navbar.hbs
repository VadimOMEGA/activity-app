<header class="admin-navbar">
	<!-- Mobile sidebar toggle -->
	<button class="sidebar-toggle" aria-label="Toggle sidebar">
		<i class="bi bi-list"></i>
	</button>

	<div class="navbar-user">
		<!-- Profile name — click to edit profile -->
		<span class="user-name" onclick="openProfileModal('{{currentUser.profileId}}', '{{currentUser.profile.name}}', '{{currentUser.profile.email}}', '{{currentUser.profile.phone}}', '{{currentUser.profile.birthDate}}')" title="Edit profile">
			{{currentUser.profile.name}}
		</span>

		<!-- Role badges -->
		{{#each currentUser.roles}}
		<span class="badge badge-role-{{toLowerCase this.role.name}}">{{this.role.name}}</span>
		{{/each}}

		<!-- Settings (username/password) -->
		<button class="btn-icon" data-bs-toggle="modal" data-bs-target="#userSettingsModal" title="Account settings">
			<i class="bi bi-gear-fill"></i>
		</button>

		<!-- Logout -->
		<a href="/admin/logout" class="btn-logout text-decoration-none" title="Logout">
			<i class="bi bi-box-arrow-right"></i> Logout
		</a>
	</div>
</header>

<!-- Profile Edit Modal (reusable) -->
<div class="modal fade" id="profileEditModal" tabindex="-1" aria-labelledby="profileEditModalLabel" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="profileEditModalLabel">Edit Profile</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<input type="hidden" id="profileEditId">
				<div class="mb-3">
					<label for="profileEditName" class="form-label">Name</label>
					<input type="text" class="form-control" id="profileEditName" required>
				</div>
				<div class="mb-3">
					<label for="profileEditEmail" class="form-label">Email</label>
					<input type="email" class="form-control" id="profileEditEmail" required>
				</div>
				<div class="mb-3">
					<label for="profileEditPhone" class="form-label">Phone</label>
					<input type="text" class="form-control" id="profileEditPhone" required>
				</div>
				<div class="mb-3">
					<label for="profileEditBirthDate" class="form-label">Birth Date</label>
					<input type="date" class="form-control" id="profileEditBirthDate" required>
				</div>
			</div>
			<div class="modal-footer">
				<button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
				<button type="button" class="btn btn-teal btn-sm" onclick="saveProfile()">Save Changes</button>
			</div>
		</div>
	</div>
</div>

<!-- User Settings Modal (password/username) -->
<div class="modal fade" id="userSettingsModal" tabindex="-1" aria-labelledby="userSettingsModalLabel" aria-hidden="true">
	<div class="modal-dialog">
		<div class="modal-content">
			<div class="modal-header">
				<h5 class="modal-title" id="userSettingsModalLabel">Account Settings</h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
			</div>
			<div class="modal-body">
				<!-- Change Username -->
				<h6 class="text-teal mb-3">Change Username</h6>
				<div class="mb-3">
					<label class="form-label">Current Username</label>
					<input type="text" class="form-control" id="currentUsername" value="{{currentUser.username}}" readonly>
				</div>
				<div class="mb-4">
					<label for="newUsername" class="form-label">New Username</label>
					<input type="text" class="form-control" id="newUsername">
				</div>
				<button type="button" class="btn btn-outline-teal btn-sm mb-4" onclick="changeUsername()">Update Username</button>

				<hr class="border-secondary">

				<!-- Change Password -->
				<h6 class="text-teal mb-3 mt-3">Change Password</h6>
				<div class="mb-3">
					<label for="oldPassword" class="form-label">Old Password</label>
					<input type="password" class="form-control" id="oldPassword">
				</div>
				<div class="mb-3">
					<label for="newPassword" class="form-label">New Password</label>
					<input type="password" class="form-control" id="newPassword">
				</div>
				<button type="button" class="btn btn-outline-teal btn-sm" onclick="changePassword()">Update Password</button>
			</div>
		</div>
	</div>
</div>

<script>
	// Store current user data for JS usage
	window.__currentUser = {
		id: '{{currentUser.id}}',
		profileId: '{{currentUser.profileId}}',
		username: '{{currentUser.username}}'
	}

	function openProfileModal(profileId, name, email, phone, birthDate) {
		document.getElementById('profileEditId').value = profileId
		document.getElementById('profileEditName').value = name || ''
		document.getElementById('profileEditEmail').value = email || ''
		document.getElementById('profileEditPhone').value = phone || ''

		if (birthDate) {
			const d = new Date(birthDate)
			document.getElementById('profileEditBirthDate').value = d.toISOString().split('T')[0]
		} else {
			document.getElementById('profileEditBirthDate').value = ''
		}

		new bootstrap.Modal(document.getElementById('profileEditModal')).show()
	}

	async function saveProfile() {
		const id = document.getElementById('profileEditId').value
		const body = {
			name: document.getElementById('profileEditName').value,
			email: document.getElementById('profileEditEmail').value,
			phone: document.getElementById('profileEditPhone').value,
			birthDate: document.getElementById('profileEditBirthDate').value
		}

		try {
			await apiCall(`/api/profiles/${id}`, 'PUT', body)
			showToast('Profile updated successfully')
			bootstrap.Modal.getInstance(document.getElementById('profileEditModal')).hide()
			setTimeout(() => reloadPage(), 500)
		} catch (err) {
			showToast(err.message || 'Failed to update profile', 'error')
		}
	}

	async function changeUsername() {
		const username = document.getElementById('newUsername').value
		if (!username) return showToast('Please enter a new username', 'error')

		try {
			await apiCall(`/api/users/change-username/${window.__currentUser.id}`, 'PUT', { username })
			showToast('Username updated successfully')
			setTimeout(() => reloadPage(), 500)
		} catch (err) {
			showToast(err.message || 'Failed to change username', 'error')
		}
	}

	async function changePassword() {
		const oldPassword = document.getElementById('oldPassword').value
		const newPassword = document.getElementById('newPassword').value
		if (!oldPassword || !newPassword) return showToast('Please fill in both fields', 'error')

		try {
			await apiCall(`/api/users/reset-password/${window.__currentUser.id}`, 'PUT', { oldPassword, newPassword })
			showToast('Password updated successfully')
			document.getElementById('oldPassword').value = ''
			document.getElementById('newPassword').value = ''
		} catch (err) {
			showToast(err.message || 'Failed to change password', 'error')
		}
	}
</script>
